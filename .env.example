# ===== Backend =====
# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ailp
POSTGRES_PASSWORD=ailp_password
POSTGRES_DB=ailp
DATABASE_URL=postgresql+asyncpg://ailp:ailp_password@localhost:5432/ailp

# Redis (bỏ trống nếu muốn chạy fallback inline không Redis)
REDIS_URL=redis://localhost:6379/0

# LLM Provider: mock | openai | anthropic | ...
LLM_PROVIDER=mock
# KHÔNG commit key thật. Để trống khi dùng mock.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=

# App
CORS_ORIGINS=http://localhost:3000
ENV=development

# ===== Frontend =====
NEXT_PUBLIC_API_URL=http://localhost:8000
