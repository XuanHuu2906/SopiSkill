# ===== Backend =====
# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ailp
POSTGRES_PASSWORD=ailp_password
POSTGRES_DB=ailp
DATABASE_URL=postgresql+asyncpg://ailp:ailp_password@localhost:5432/ailp

# Redis (bỏ trống nếu muốn chạy fallback inline không Redis)
REDIS_URL=redis://localhost:6379/0

# LLM Provider: mock | openai | openai_compatible
# Provider lạ hoặc thiếu key/model/base URL ⇒ API trả 503 PROVIDER_NOT_CONFIGURED.
# KHÔNG bao giờ fallback im lặng sang mock.
LLM_PROVIDER=mock

# --- Provider thật (chỉ điền khi đã được duyệt ngân sách & dữ liệu gửi ra ngoài) ---
# Key CHỈ tồn tại server-side; không đưa vào NEXT_PUBLIC_* hay commit.
LLM_API_KEY=
# Endpoint tương thích OpenAI, KHÔNG kèm /chat/completions (adapter tự nối).
# Ví dụ: https://api.openai.com/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=2000
LLM_MAX_INPUT_CHARS=12000
LLM_MAX_OUTPUT_TOKENS_JUDGE=3000

# ===== P2.2 cost control =====
# Giá model để tính costEstimateUsd (USD / 1 triệu token). Để trống = CHƯA BIẾT
# giá (API trả costEstimateUsd=null, costKnown=false), KHÔNG phải miễn phí.
# Ví dụ: LLM_PRICING_JSON={"deepseek-ai/deepseek-v4.1-flash-1017":{"inputPerMTok":0.27,"outputPerMTok":1.1}}
LLM_PRICING_JSON=
# Trần token (prompt+completion) cho một generation job. 0 = không giới hạn.
GENERATION_MAX_TOKENS_PER_JOB=400000
# Trần chi phí ước tính (USD) cho một job. 0 = không giới hạn.
GENERATION_MAX_COST_USD_PER_JOB=0

# Tương thích .env cũ (không dùng trực tiếp; LLM_API_KEY được ưu tiên)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# App
CORS_ORIGINS=http://localhost:3000
ENV=development

# Auth — BẮT BUỘC. Sinh secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=sopiskill
JWT_AUDIENCE=sopiskill-web
ACCESS_TOKEN_TTL_MINUTES=10080
# Demo header X-User-Id — chỉ cho local dev, KHÔNG bật ở production
ALLOW_DEMO_HEADER=false
# Cookie Secure — bật true khi chạy HTTPS
COOKIE_SECURE=false

# ===== Generation job reliability (P1.2) =====
# Lease của worker (giây). Lease hết hạn → reconciler requeue cho worker khác.
GENERATION_LEASE_SECONDS=180
# Số lần claim tối đa cho một job (bounded retry, không vòng lặp vô hạn).
GENERATION_MAX_ATTEMPTS=3
# Backoff cơ sở (giây): 2, 4, 8... chặn tối đa 60s.
GENERATION_RETRY_BACKOFF_SECONDS=2
# Timeout gọi provider cho mỗi lesson.
GENERATION_LESSON_TIMEOUT_SECONDS=60
# Reconciler (outbox) chạy mỗi N giây.
GENERATION_RECONCILE_INTERVAL_SECONDS=30
# false = production/no-broker: để job queued cho reconciler, không chạy inline.
GENERATION_ALLOW_INLINE_FALLBACK=true

# ===== P3.0 AI Tutor =====
# MẶC ĐỊNH TẮT. Bật khi muốn dùng trợ giảng trong bài học (endpoint trả 503 nếu tắt).
TUTOR_ENABLED=false
# Số message history gửi kèm mỗi lời gọi (bounded).
TUTOR_HISTORY_MAX_MESSAGES=12
TUTOR_MAX_QUESTION_CHARS=2000
# Trần ký tự lesson đưa vào prompt (chỉ public blocks, không có answer key).
TUTOR_CONTEXT_MAX_CHARS=6000
LLM_MAX_OUTPUT_TOKENS_TUTOR=900
# Timeout tổng một stream + nhịp heartbeat khi provider chưa trả token.
TUTOR_STREAM_TIMEOUT_SECONDS=60
TUTOR_HEARTBEAT_SECONDS=15
# Số lượt hỏi/24h/user. 0 = chưa giới hạn (P3.1 làm quota đầy đủ).
TUTOR_MESSAGES_PER_DAY=0

# ===== Frontend =====
NEXT_PUBLIC_API_URL=http://localhost:8000

# P2.1 schema repair (bounded)
LLM_MAX_SCHEMA_RETRIES=1
# Token budget theo loại call
LLM_MAX_OUTPUT_TOKENS_INTERVIEW=800
LLM_MAX_OUTPUT_TOKENS_PROPOSAL=4500
LLM_MAX_OUTPUT_TOKENS_LESSON=3000

# ===== P3.0 Source Registry & Source-First =====
# Adapter discovery nguồn: curated | mock (cả hai KHÔNG gọi network) | web (chưa triển khai → 503)
SOURCE_DISCOVERY_ADAPTER=curated
# Danh mục nguồn chọn tay (JSON array). Ví dụ:
# [{"id":"py-docs","title":"Python Documentation","sourceType":"official_documentation","canonicalUrl":"https://docs.python.org/3/","publisher":"Python Software Foundation","language":"en","version":"3.13"}]
SOURCE_CURATED_CATALOG=
# Đưa metadata nguồn đã liên kết vào prompt sinh bài học (không phải nội dung).
SOURCE_CONTEXT_ENABLED=true
# Trần ký tự excerpt mỗi nguồn — P3.0 chưa ingest nên để 0 (không gửi nội dung).
SOURCE_CONTEXT_MAX_CHARS=0

# ===== P2.SR Source Research Agent =====
# MẶC ĐỊNH TẮT để bảo toàn hành vi cũ. Bật chỉ khi muốn course flow gọi agent.
SOURCE_RESEARCH_ENABLED=false
# mock | curated (cả hai KHÔNG gọi network). web chưa triển khai → lỗi cấu hình.
SOURCE_RESEARCH_PROVIDER=mock
SOURCE_RESEARCH_MAX_SOURCES=8
# Trần thời gian một lần nghiên cứu và trần tool call (bounded, không treo job).
SOURCE_RESEARCH_TIMEOUT_SECONDS=15
SOURCE_RESEARCH_MAX_TOOL_CALLS=12
SOURCE_RESEARCH_TOOL_TIMEOUT_SECONDS=5
# Tự động nghiên cứu + link nguồn metadata_verified khi generation bắt đầu.
# Chỉ có hiệu lực khi SOURCE_RESEARCH_ENABLED=true và provider không phải mock.
SOURCE_RESEARCH_AUTO_LINK=false
