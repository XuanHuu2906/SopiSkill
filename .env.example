# ===== Backend =====
# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ailp
POSTGRES_PASSWORD=ailp_password
POSTGRES_DB=ailp
DATABASE_URL=postgresql+asyncpg://ailp:ailp_password@localhost:5432/ailp

# Redis (bỏ trống nếu muốn chạy fallback inline không Redis)
REDIS_URL=redis://localhost:6379/0

# LLM Provider: mock | openai | anthropic | ...
LLM_PROVIDER=mock
# KHÔNG commit key thật. Để trống khi dùng mock.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=

# App
CORS_ORIGINS=http://localhost:3000
ENV=development

# Auth — BẮT BUỘC. Sinh secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=sopiskill
JWT_AUDIENCE=sopiskill-web
ACCESS_TOKEN_TTL_MINUTES=10080
# Demo header X-User-Id — chỉ cho local dev, KHÔNG bật ở production
ALLOW_DEMO_HEADER=false
# Cookie Secure — bật true khi chạy HTTPS
COOKIE_SECURE=false

# ===== Frontend =====
NEXT_PUBLIC_API_URL=http://localhost:8000
